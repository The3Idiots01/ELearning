###############################################################################
# Learnova — Assessment Quiz authoring and taking flow
# Run requests from top to bottom with VS Code REST Client or JetBrains HTTP Client.
###############################################################################

@baseUrl = http://localhost:8080
@lecturerEmail = quangtienhoihop@gmail.com
@lecturerPassword = 123456
@learnerEmail = learner@example.com
@learnerPassword = 123456

### Lecturer login
# @name lecturerLogin
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{lecturerEmail}}",
  "password": "{{lecturerPassword}}"
}

###
@lecturerToken = {{lecturerLogin.response.body.$.result.accessToken}}

### Create draft course
# @name createCourse
POST {{baseUrl}}/api/v1/lecturer/courses
Content-Type: application/json
Authorization: Bearer {{lecturerToken}}

{
  "title": "Khóa học Test Assessment Quiz",
  "categoryId": 1
}

###
@courseId = {{createCourse.response.body.$.result.id}}

### Create first learning outcome
# @name createOutcome1
POST {{baseUrl}}/api/v1/lecturer/courses/{{courseId}}/outcomes
Content-Type: application/json
Authorization: Bearer {{lecturerToken}}

{
  "statement": "Xây dựng REST API bằng Spring Boot"
}

###
@outcomeId1 = {{createOutcome1.response.body.$.result.id}}

### Create second learning outcome
# @name createOutcome2
POST {{baseUrl}}/api/v1/lecturer/courses/{{courseId}}/outcomes
Content-Type: application/json
Authorization: Bearer {{lecturerToken}}

{
  "statement": "Áp dụng đúng HTTP semantics"
}

###
@outcomeId2 = {{createOutcome2.response.body.$.result.id}}

### Create an unplaced quiz assessment and map both outcomes
# @name createAssessment
POST {{baseUrl}}/api/v1/lecturer/courses/{{courseId}}/assessments
Content-Type: application/json
Authorization: Bearer {{lecturerToken}}

{
  "type": "QUIZ",
  "title": "Kiểm tra REST API và HTTP",
  "instructions": "Chọn đáp án đúng cho từng câu hỏi",
  "outcomeIds": [{{outcomeId1}}, {{outcomeId2}}]
}

###
@assessmentId = {{createAssessment.response.body.$.result.id}}

### Configure quiz (title belongs to assessment, not quiz config)
# @name upsertQuiz
PUT {{baseUrl}}/api/v1/lecturer/courses/{{courseId}}/assessments/{{assessmentId}}/quiz
Content-Type: application/json
Authorization: Bearer {{lecturerToken}}

{
  "passingScore": 70.00,
  "maxAttempts": 3
}

### Add SINGLE_CHOICE question aligned to outcome 1
# @name addQuestion1
POST {{baseUrl}}/api/v1/lecturer/courses/{{courseId}}/assessments/{{assessmentId}}/quiz/questions
Content-Type: application/json
Authorization: Bearer {{lecturerToken}}

{
  "questionText": "Annotation nào khai báo REST controller?",
  "questionType": "SINGLE_CHOICE",
  "points": 1.00,
  "options": [
    {"id": "a", "text": "@RestController", "isCorrect": true, "explanation": "Đúng."},
    {"id": "b", "text": "@Service", "isCorrect": false}
  ]
}

###
@questionId1 = {{addQuestion1.response.body.$.result.id}}

### Add MULTIPLE_CHOICE question aligned to outcome 2
# @name addQuestion2
POST {{baseUrl}}/api/v1/lecturer/courses/{{courseId}}/assessments/{{assessmentId}}/quiz/questions
Content-Type: application/json
Authorization: Bearer {{lecturerToken}}

{
  "questionText": "Phương thức HTTP nào là idempotent?",
  "questionType": "MULTIPLE_CHOICE",
  "points": 2.00,
  "options": [
    {"id": "a", "text": "GET", "isCorrect": true},
    {"id": "b", "text": "PUT", "isCorrect": true},
    {"id": "c", "text": "POST", "isCorrect": false}
  ]
}

###
@questionId2 = {{addQuestion2.response.body.$.result.id}}

### Read authoring detail (includes answers)
GET {{baseUrl}}/api/v1/lecturer/courses/{{courseId}}/assessments/{{assessmentId}}/quiz
Authorization: Bearer {{lecturerToken}}

### Reorder questions
PATCH {{baseUrl}}/api/v1/lecturer/courses/{{courseId}}/assessments/{{assessmentId}}/quiz/questions/reorder
Content-Type: application/json
Authorization: Bearer {{lecturerToken}}

{
  "questionIds": [{{questionId2}}, {{questionId1}}]
}

###############################################################################
# Learner flow. The course must be published and this learner must be enrolled.
###############################################################################

### Learner login
# @name learnerLogin
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{learnerEmail}}",
  "password": "{{learnerPassword}}"
}

###
@learnerToken = {{learnerLogin.response.body.$.result.accessToken}}

### Get safe quiz paper (never includes isCorrect or explanation)
GET {{baseUrl}}/api/v1/learner/courses/{{courseId}}/assessments/{{assessmentId}}/quiz
Authorization: Bearer {{learnerToken}}

### Submit and receive server-side grading details
POST {{baseUrl}}/api/v1/learner/courses/{{courseId}}/assessments/{{assessmentId}}/quiz/attempts
Content-Type: application/json
Authorization: Bearer {{learnerToken}}

{
  "answers": [
    {"questionId": {{questionId1}}, "selectedOptionIds": ["a"]},
    {"questionId": {{questionId2}}, "selectedOptionIds": ["a", "b"]}
  ]
}

### Attempt history
GET {{baseUrl}}/api/v1/learner/courses/{{courseId}}/assessments/{{assessmentId}}/quiz/attempts
Authorization: Bearer {{learnerToken}}
