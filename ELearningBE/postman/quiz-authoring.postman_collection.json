{
  "info": {
    "_postman_id": "c928fae1-4b17-4389-9831-75466ba0e481",
    "name": "Learnova - Assessment Quiz APIs",
    "description": "Assessment-based quiz authoring and learner taking APIs (Tasks 05-06).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8080", "type": "string"},
    {"key": "lecturerToken", "value": "", "type": "string"},
    {"key": "learnerToken", "value": "", "type": "string"},
    {"key": "courseId", "value": "1", "type": "string"},
    {"key": "assessmentId", "value": "1", "type": "string"},
    {"key": "questionId", "value": "1", "type": "string"}
  ],
  "item": [
    {
      "name": "Instructor quiz authoring",
      "item": [
        {
          "name": "Configure assessment quiz",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{lecturerToken}}"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"passingScore\": 80.00,\n  \"maxAttempts\": 3\n}"},
            "url": {
              "raw": "{{baseUrl}}/api/v1/lecturer/courses/{{courseId}}/assessments/{{assessmentId}}/quiz",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "lecturer", "courses", "{{courseId}}", "assessments", "{{assessmentId}}", "quiz"]
            }
          }
        },
        {
          "name": "Get authoring detail",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{lecturerToken}}"}],
            "url": {
              "raw": "{{baseUrl}}/api/v1/lecturer/courses/{{courseId}}/assessments/{{assessmentId}}/quiz",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "lecturer", "courses", "{{courseId}}", "assessments", "{{assessmentId}}", "quiz"]
            }
          }
        },
        {
          "name": "Add outcome-aligned question",
          "event": [{
            "listen": "test",
            "script": {"type": "text/javascript", "exec": [
              "const json = pm.response.json();",
              "if (json.result?.id) pm.collectionVariables.set('questionId', json.result.id);"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{lecturerToken}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"outcomeId\": {{outcomeId}},\n  \"questionText\": \"Annotation nào khai báo REST controller?\",\n  \"questionType\": \"SINGLE_CHOICE\",\n  \"points\": 1.00,\n  \"options\": [\n    {\"id\": \"a\", \"text\": \"@RestController\", \"isCorrect\": true, \"explanation\": \"Đúng.\"},\n    {\"id\": \"b\", \"text\": \"@Service\", \"isCorrect\": false}\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/lecturer/courses/{{courseId}}/assessments/{{assessmentId}}/quiz/questions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "lecturer", "courses", "{{courseId}}", "assessments", "{{assessmentId}}", "quiz", "questions"]
            }
          }
        },
        {
          "name": "Delete question",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{lecturerToken}}"}],
            "url": {
              "raw": "{{baseUrl}}/api/v1/lecturer/courses/{{courseId}}/assessments/{{assessmentId}}/quiz/questions/{{questionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "lecturer", "courses", "{{courseId}}", "assessments", "{{assessmentId}}", "quiz", "questions", "{{questionId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Learner quiz taking",
      "item": [
        {
          "name": "Get safe quiz paper",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{learnerToken}}"}],
            "url": {
              "raw": "{{baseUrl}}/api/v1/learner/courses/{{courseId}}/assessments/{{assessmentId}}/quiz",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "learner", "courses", "{{courseId}}", "assessments", "{{assessmentId}}", "quiz"]
            }
          }
        },
        {
          "name": "Submit attempt",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{learnerToken}}"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"answers\": [\n    {\"questionId\": {{questionId}}, \"selectedOptionIds\": [\"a\"]}\n  ]\n}"},
            "url": {
              "raw": "{{baseUrl}}/api/v1/learner/courses/{{courseId}}/assessments/{{assessmentId}}/quiz/attempts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "learner", "courses", "{{courseId}}", "assessments", "{{assessmentId}}", "quiz", "attempts"]
            }
          }
        },
        {
          "name": "Get attempt history",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{learnerToken}}"}],
            "url": {
              "raw": "{{baseUrl}}/api/v1/learner/courses/{{courseId}}/assessments/{{assessmentId}}/quiz/attempts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "learner", "courses", "{{courseId}}", "assessments", "{{assessmentId}}", "quiz", "attempts"]
            }
          }
        }
      ]
    }
  ]
}
