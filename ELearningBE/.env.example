# Neon Database Credentials
DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require&channelBinding=require
DB_USERNAME=neondb_owner
DB_PASSWORD=your_db_password

# Redis Cloud Credentials
REDIS_HOST=redis-19655.crce302.ap-seast-1-3.ec2.cloud.redislabs.com
REDIS_PORT=19655
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password

# SendGrid Configuration
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=nguyentungduong221003@gmail.com

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_256_bits_long_example
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# Cloudflare R2 (S3-compatible object storage)
# STORAGE_PROVIDER: local (dev, lưu vào ./storage-data) hoặc s3 (R2 khi deploy)
STORAGE_PROVIDER=local
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=learnova
R2_ACCESS_KEY=your_r2_access_key_id
R2_SECRET_KEY=your_r2_secret_access_key
# Để trống nếu chưa gắn custom domain — download sẽ dùng presigned GET
R2_PUBLIC_BASE_URL=
